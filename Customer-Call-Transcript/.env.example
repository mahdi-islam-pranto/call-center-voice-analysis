# Copy to .env and fill in.
GOOGLE_API_KEY=

# Any LangChain chat model as "provider:model". The model must accept audio input.
# To use another provider: install its package (e.g. langchain-openai), set its
# API key here (e.g. OPENAI_API_KEY) and change this line (e.g. openai:<model-name>).
TRANSCRIPT_MODEL=google_genai:gemini-3.1-flash-lite

# minimal | low | medium | high (blank = model default). Gemini calls this thinking_level.
TRANSCRIPT_REASONING_EFFORT=low

# Extra attempts when the model's reply is not a valid transcript.
TRANSCRIPT_LLM_RETRIES=1

# Token prices in USD per 1 million tokens (Google paid tier for gemini-3.1-flash-lite).
# Update these if you change TRANSCRIPT_MODEL.
TRANSCRIPT_PRICE_TEXT_INPUT_PER_1M=0.25
TRANSCRIPT_PRICE_AUDIO_INPUT_PER_1M=0.50
TRANSCRIPT_PRICE_OUTPUT_PER_1M=1.50
# Gemini counts 32 tokens per second of audio (used to split audio vs text input tokens).
TRANSCRIPT_AUDIO_TOKENS_PER_SECOND=32

TRANSCRIPT_MAX_AUDIO_MB=20
TRANSCRIPT_DOWNLOAD_TIMEOUT=60

# Batch endpoint: most URLs per request, and how many recordings run at the same time.
TRANSCRIPT_MAX_BATCH_URLS=50
TRANSCRIPT_MAX_CONCURRENCY=4

# Comma-separated hosts whose SSL certificate is not checked when downloading.
# Only for trusted internal servers reached by IP (their certificate names a domain, not the IP).
# List every such server, e.g. 103.204.81.3,103.204.81.4
TRANSCRIPT_SSL_SKIP_VERIFY_HOSTS=103.204.81.3
