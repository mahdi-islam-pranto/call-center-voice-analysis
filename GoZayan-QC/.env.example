# Copy to .env and fill in.
GOOGLE_API_KEY=

# Models per pass (pass 1 = listening/transcript, pass 2 = scoring, rollup = agent coaching text)
QC_FORENSICS_MODEL=gemini-3.1-flash-lite
QC_SCORING_MODEL=gemini-3.1-flash-lite
QC_ROLLUP_MODEL=gemini-3.1-flash-lite

# Gemini 3 thinking level per pass: minimal | low | medium | high (blank = model default)
QC_FORENSICS_THINKING=low
QC_SCORING_THINKING=medium

# Leave blank: Gemini 3 models are tuned for the default temperature.
QC_TEMPERATURE=

# Scoring policy
# N/A: full_credit (counts as Good) | exclude (rescale to 10 over applicable parameters)
QC_NA_POLICY=full_credit
# Critical error: flag (score unchanged, always reviewed) | zero (call scores 0)
QC_CRITICAL_ERROR_POLICY=flag
QC_PASS_MARK=8

QC_BRAND_NAME=GoZayaan
QC_MAX_CONCURRENCY=4
QC_MAX_UPLOAD_MB=20
QC_MAX_UPLOAD_FILES=30
